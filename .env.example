# Copy this to .env.local for local development (Next.js loads .env.local
# automatically and it's gitignored). All NEXT_PUBLIC_* values are inlined
# into the client bundle at build time, not read at runtime.

# --- Backend / gameserver (required) ---
NEXT_PUBLIC_API_URL=http://localhost:4001
NEXT_PUBLIC_GAMESERVER_URL=http://localhost:8080

# --- Error tracking (optional) ---
NEXT_PUBLIC_SENTRY_DSN=
